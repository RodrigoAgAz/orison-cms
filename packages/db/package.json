{
  "name": "@orison/db",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prisma:generate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "prisma:push": "node --env-file=../../.env ../../node_modules/prisma/build/index.js db push --schema prisma/schema.prisma",
    "prisma:seed": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "prisma": {
    "seed": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  }
}
