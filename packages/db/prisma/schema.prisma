generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
}

model DeviceGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  devices     Device[]
  loops       Loop[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id             String           @id @default(cuid())
  filename       String
  s3Key          String           @unique
  mimeType       String
  durationMs     Int?
  width          Int?
  height         Int?
  fileSize       Int
  checksum       String?
  thumbnailKey   String?
  category       AssetCategory
  status         AssetStatus      @default(PROCESSING)
  metadata       Json?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  slotPlacements SlotContent[]
  staticSlots    Slot[]           @relation("SlotStaticCreative")
}

enum AssetCategory {
  ADVERTISEMENT
  STATIC_CREATIVE
  SAFETY_MESSAGE
  FILLER_WEATHER
  FILLER_NEWS
  FILLER_BRANDED
  FILLER_OTHER
}

enum AssetStatus {
  PROCESSING
  READY
  FAILED
}

model Loop {
  id               String      @id @default(cuid())
  name             String
  status           LoopStatus  @default(DRAFT)
  publishError     String?
  version          Int         @default(1)
  checksum         String?
  targetGroupId    String?
  targetGroup      DeviceGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  slots            Slot[]
  publishedAt      DateTime?
  publishedBy      String?
  manifestUrl      String?
  manifestKey      String?
  compiledVideoUrl String?
  compiledVideoKey String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum LoopStatus {
  DRAFT
  REVIEW
  PUBLISHING
  PUBLISHED
  ARCHIVED
}

model Slot {
  id               String   @id @default(cuid())
  loopId           String
  loop             Loop     @relation(fields: [loopId], references: [id], onDelete: Cascade)
  position         Int
  contents         SlotContent[]
  staticCreativeId String?
  staticCreative   Asset?   @relation("SlotStaticCreative", fields: [staticCreativeId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([loopId, position])
}

model SlotContent {
  id          String          @id @default(cuid())
  slotId       String
  slot         Slot            @relation(fields: [slotId], references: [id], onDelete: Cascade)
  assetId      String
  asset        Asset           @relation(fields: [assetId], references: [id])
  orderInSlot  Int
  startTimeMs  Int
  durationMs   Int
  contentType  SlotContentType
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([slotId, orderInSlot])
}

enum SlotContentType {
  ADVERTISEMENT
  FILLER
}

model Device {
  id               String            @id @default(cuid())
  serialNumber     String            @unique
  cabLicenseNumber String?
  driverName       String?
  hpTaxiCabId      String?
  groupId          String?
  group            DeviceGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  isActive         Boolean           @default(true)
  isDisabled       Boolean           @default(false)
  disabledReason   String?
  currentLoopId    String?
  lastSyncAt       DateTime?
  lastHeartbeatAt  DateTime?
  ipAddress        String?
  firmwareVersion  String?
  storageFreeMb    Int?
  notes            String?
  apiTokenHash     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  playbackLogs     PlaybackLog[]
  heartbeats       DeviceHeartbeat[]
}

model DeviceHeartbeat {
  id                String    @id @default(cuid())
  deviceId          String
  device            Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ipAddress         String?
  firmwareVersion   String?
  storageFreeMb     Int?
  currentLoopId     String?
  cpuTemp           Float?
  uptimeSeconds     Int?
  memoryUsedPercent Float?
  playerStatus      String?
  networkType       String?
  signalStrength    Int?
  locationData      Json?
  receivedAt        DateTime  @default(now())

  @@index([deviceId, receivedAt])
}

model PlaybackLog {
  id            String          @id @default(cuid())
  deviceId       String
  device         Device          @relation(fields: [deviceId], references: [id])
  deviceSerial   String?
  loopId         String
  slotPosition   Int?
  contentType    SlotContentType?
  assetId        String?
  playbackType   String?
  eventName      String?
  mode           String?
  playerState    String?
  playedAt       DateTime
  completedFull  Boolean         @default(true)
  durationMs     Int?
  journeyId      String?
  locationData   Json?
  createdAt      DateTime        @default(now())

  @@index([deviceId, playedAt])
  @@index([loopId, playedAt])
  @@index([journeyId, playedAt])
}

model ActivityEvent {
  id        String            @id @default(cuid())
  type      ActivityEventType
  message   String
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([createdAt])
}

enum ActivityEventType {
  LOOP_CREATED
  LOOP_PUBLISHED
  ASSET_UPLOADED
  ASSET_READY
  DEVICE_REGISTERED
  DEVICE_GROUP_CREATED
  DEVICE_GROUP_UPDATED
  DEVICE_GROUP_DELETED
  DEVICE_SYNCED
  DEVICE_OFFLINE
  DEVICE_DISABLED
  DEVICE_ENABLED
  SYNC_FAILED
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
