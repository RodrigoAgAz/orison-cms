generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EDITOR)
  // Carried in the session token; bumping it signs the user out everywhere (password change,
  // admin reset, role change). See lib/auth.ts.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
}

model DeviceGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  devices     Device[]
  loops       Loop[]
  // Explicit loop assignment for this group (mobile app). assignmentAt set with
  // assignedLoopId null means "follow the fleet". See lib/loop-routing.ts.
  assignedLoopId String?
  assignmentAt   DateTime?
  assignedBy     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id             String           @id @default(cuid())
  filename       String
  s3Key          String           @unique
  mimeType       String
  durationMs     Int?
  width          Int?
  height         Int?
  fileSize       Int
  checksum       String?
  thumbnailKey   String?
  category       AssetCategory
  status         AssetStatus      @default(PROCESSING)
  metadata       Json?
  errorMessage   String?
  // Removed from the library by staff while loops still use it: hidden, file kept for those loops.
  hiddenAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  slotPlacements SlotContent[]
  staticSlots    Slot[]           @relation("SlotStaticCreative")
}

enum AssetCategory {
  ADVERTISEMENT
  STATIC_CREATIVE
  SAFETY_MESSAGE
  FILLER_WEATHER
  FILLER_NEWS
  FILLER_BRANDED
  FILLER_OTHER
}

enum AssetStatus {
  PROCESSING
  READY
  FAILED
}

model Loop {
  id               String      @id @default(cuid())
  name             String
  status           LoopStatus  @default(DRAFT)
  publishError     String?
  version          Int         @default(1)
  checksum         String?
  targetGroupId    String?
  targetGroup      DeviceGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  slots            Slot[]
  publishedAt      DateTime?
  publishedBy      String?
  manifestUrl      String?
  manifestKey      String?
  compiledVideoUrl String?
  compiledVideoKey String?
  // false for phone uploads: they only go live through an explicit assignment.
  autoLive         Boolean     @default(true)
  durationMs       Int?
  posterKey        String?
  // Assignment target requested at upload time, applied once processing succeeds.
  pendingTarget    Json?
  // When the upload with pendingTarget was requested; null once the target has been applied or
  // skipped (a newer change to the same target wins). Non-null on a PUBLISHED loop = still applying.
  pendingTargetAt  DateTime?
  // Desktop publish job (apps/web/src/lib/loop-publish.ts). While publishJobId is set a background
  // compile is running; the loop keeps serving its current compiled video until the new one swaps
  // in. publishHeartbeatAt is touched while the job runs; a stale one means it was interrupted.
  publishJobId       String?
  publishHeartbeatAt DateTime?
  publishProgress    Json?
  // Keys of what is compiled and published (lib/loop-plan.ts); null for loops published before.
  compiledContentKey String?
  manifestContentKey String?
  // Key of the slots as last published (picture, sound and stills); differs from the saved slots'
  // key when there are changes not yet published.
  publishedDraftKey  String?
  // Objects superseded by a newer publish, deleted after a grace period: [{ key, retiredAt }].
  retiredObjects     Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum LoopStatus {
  DRAFT
  REVIEW
  PUBLISHING
  PUBLISHED
  ARCHIVED
}

model Slot {
  id               String   @id @default(cuid())
  loopId           String
  loop             Loop     @relation(fields: [loopId], references: [id], onDelete: Cascade)
  position         Int
  contents         SlotContent[]
  staticCreativeId String?
  staticCreative   Asset?   @relation("SlotStaticCreative", fields: [staticCreativeId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([loopId, position])
}

model SlotContent {
  id          String          @id @default(cuid())
  slotId       String
  slot         Slot            @relation(fields: [slotId], references: [id], onDelete: Cascade)
  assetId      String
  asset        Asset           @relation(fields: [assetId], references: [id])
  orderInSlot  Int
  startTimeMs  Int
  durationMs   Int
  contentType  SlotContentType
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([slotId, orderInSlot])
}

enum SlotContentType {
  ADVERTISEMENT
  FILLER
}

model Device {
  id               String            @id @default(cuid())
  serialNumber     String            @unique
  cabLicenseNumber String?
  driverName       String?
  hpTaxiCabId      String?
  groupId          String?
  group            DeviceGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  isActive         Boolean           @default(true)
  isDisabled       Boolean           @default(false)
  disabledReason   String?
  currentLoopId    String?
  lastSyncAt       DateTime?
  lastHeartbeatAt  DateTime?
  ipAddress        String?
  firmwareVersion  String?
  storageFreeMb    Int?
  notes            String?
  apiTokenHash     String?
  // Per-cab loop override (sticky until cleared).
  overrideLoopId   String?
  overrideAt       DateTime?
  overrideBy       String?
  // Best-known position, resolved from heartbeats (gps fix or cell tower lookup).
  locationLat      Float?
  locationLng      Float?
  locationAccuracyM Float?
  locationSource   String?
  locationAt       DateTime?
  // Latest state reported in heartbeats, kept here so list pages never read DeviceHeartbeat.
  // statusReportedAt is when the heartbeat that set them arrived (null: none since this existed).
  playerStatus     String?
  // Fine-grained player state from firmware 1.2.0+ (IDLE, SAFETY, JOURNEY, SILENT, ...).
  playerState      String?
  // How journeys start: "gpio" | "keyboard" | "always" (no passenger detection). Null: firmware
  // older than 1.2.0, which always has passenger detection.
  playbackTrigger  String?
  signalPercent    Int?
  signalDbm        Int?
  networkType      String?
  uptimeSeconds    Int?
  safetyChecksum   String?
  statusReportedAt DateTime?
  // Content sync as reported by firmware 1.2.0+: "ok" | "downloading" | "failed".
  syncState        String?
  syncError        String?
  syncFailedLoopId String?
  syncStateSince   DateTime?
  syncNextRetryAt  DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  playbackLogs     PlaybackLog[]
  heartbeats       DeviceHeartbeat[]
}

model DeviceHeartbeat {
  id                String    @id @default(cuid())
  deviceId          String
  device            Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ipAddress         String?
  firmwareVersion   String?
  storageFreeMb     Int?
  currentLoopId     String?
  cpuTemp           Float?
  uptimeSeconds     Int?
  memoryUsedPercent Float?
  playerStatus      String?
  networkType       String?
  // As sent: dBm when negative; old firmware sends a 0-100 quality percentage here.
  signalStrength    Int?
  signalPercent     Int?
  playerState       String?
  playbackTrigger   String?
  safetyChecksum    String?
  syncState         String?
  syncError         String?
  locationData      Json?
  receivedAt        DateTime  @default(now())

  @@index([deviceId, receivedAt])
}

model PlaybackLog {
  id            String          @id @default(cuid())
  deviceId       String
  device         Device          @relation(fields: [deviceId], references: [id])
  deviceSerial   String?
  loopId         String
  slotPosition   Int?
  contentType    SlotContentType?
  assetId        String?
  playbackType   String?
  eventName      String?
  mode           String?
  playerState    String?
  playedAt       DateTime
  completedFull  Boolean         @default(true)
  durationMs     Int?
  journeyId      String?
  // Set by firmware 1.2.0+ (unique per entry on the cab): re-sent entries are skipped, and rows
  // with an eventId carry measured durations and completion. Null on older firmware's rows.
  eventId        String?
  // Only kept for journey start/end markers.
  locationData   Json?
  createdAt      DateTime        @default(now())

  // Also serves the (deviceId, eventId) duplicate check, which is bounded by the batch's playedAt.
  @@index([deviceId, playedAt])
  // Analytics date ranges and the CSV export's keyset pagination.
  @@index([playedAt, id])
}

model ActivityEvent {
  id        String            @id @default(cuid())
  type      ActivityEventType
  message   String
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([createdAt])
}

enum ActivityEventType {
  LOOP_CREATED
  LOOP_PUBLISHED
  ASSET_UPLOADED
  ASSET_READY
  DEVICE_REGISTERED
  DEVICE_GROUP_CREATED
  DEVICE_GROUP_UPDATED
  DEVICE_GROUP_DELETED
  DEVICE_SYNCED
  DEVICE_OFFLINE
  DEVICE_DISABLED
  DEVICE_ENABLED
  SYNC_FAILED
  LOOP_ASSIGNED
  LOOP_ARCHIVED
  LOOP_UPLOAD_FAILED
  LOOP_UPLOAD_DISCARDED
  LOOP_ASSIGNMENT_SKIPPED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_PASSWORD_CHANGED
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Cache of cell tower -> coordinates lookups (positive and negative).
model CellTowerLocation {
  id          String    @id @default(cuid())
  radio       String
  mcc         Int
  mnc         Int
  lac         Int
  cellId      Int
  found       Boolean
  lat         Float?
  lng         Float?
  accuracyM   Float?
  provider    String?
  // For misses/errors: do not query providers again before this time.
  retryAfter  DateTime?
  lookedUpAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([radio, mcc, mnc, lac, cellId])
}
