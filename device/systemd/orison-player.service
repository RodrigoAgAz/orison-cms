[Unit]
Description=Orison Screens Player Manager
After=network-online.target orison-sync.service
Wants=network-online.target

[Service]
Type=simple
User=orison
WorkingDirectory=/opt/orison
ExecStart=/usr/bin/python3 /opt/orison/player_manager.py
Restart=always
RestartSec=5
WatchdogSec=60
Environment=DISPLAY=:0

[Install]
WantedBy=multi-user.target

