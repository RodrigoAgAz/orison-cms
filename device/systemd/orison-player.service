[Unit]
Description=Orison Screens Player Manager
# No network wait: the screen must come up as soon as the box boots.
After=local-fs.target orison-sync.service
StartLimitIntervalSec=0

[Service]
# The player sends READY=1 once it is running and WATCHDOG=1 from its main loop while that loop is
# making progress; systemd restarts it if the pings stop for WatchdogSec. If mpv cannot be kept
# running (10 quick failures in a row, with backoff and a second video output tried) the player
# exits with status 75 and systemd restarts it here.
Type=notify
NotifyAccess=main
WatchdogSec=90
TimeoutStartSec=120
TimeoutStopSec=20
User=orison
WorkingDirectory=/opt/orison
ExecStart=/usr/bin/python3 /opt/orison/player_manager.py
Restart=always
RestartSec=5
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
