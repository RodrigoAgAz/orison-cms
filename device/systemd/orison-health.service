[Unit]
Description=Orison Screens Health Monitor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=orison
WorkingDirectory=/opt/orison
ExecStart=/usr/bin/python3 /opt/orison/health_monitor.py
Restart=always
RestartSec=10
# Flush the playback log and finish an upload in progress on shutdown.
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
