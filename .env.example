DATABASE_URL=postgresql://orison:password@localhost:5432/orison_cms

# Object storage (S3-compatible). Required in production; without it, local development keeps files
# under apps/web/tmp/storage. S3_FORCE_PATH_STYLE=false selects virtual-hosted URLs (newer Railway
# buckets); path-style is the default when AWS_ENDPOINT is set.
S3_BUCKET=orison-content
S3_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
# S3_FORCE_PATH_STYLE=
# Public base URL that serves the bucket's objects directly. Leave blank to serve files through this
# app (/api/storage/..., redirected to short-lived signed object-storage URLs).
CDN_BASE_URL=

# Signs the sign-in cookie: 32+ random bytes. NEXTAUTH_SECRET (the old name) is still read when this
# is not set, so existing deployments keep working; changing the value signs everyone out.
SESSION_SECRET=replace-with-32-random-bytes
# This app's public address. Used to build file URLs; URLs that point at this app's /api/storage/
# are re-pointed at whatever address a cab or browser actually uses when they are served.
APP_URL=http://localhost:3000
APP_SESSION_COOKIE=orison_session

# First admin, created only if no user with this email exists (never changed afterwards).
DEFAULT_ADMIN_EMAIL=admin@orisonscreens.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
# Shared bearer token the cabs send (Authorization: Bearer ...).
DEVICE_SHARED_TOKEN=replace-with-device-shared-secret

# Daily pruning in the web process. Heartbeats older than this many days are deleted (default 90;
# values below 30 are raised to 30, which the phone app's cab history needs).
HEARTBEAT_RETENTION_DAYS=90
# Playback logs are what advertisers are billed from and are kept forever unless this is set
# (minimum 30).
PLAYBACK_LOG_RETENTION_DAYS=

# Cell tower geolocation for heartbeats without GPS. OpenCelliD is used first when a key is set;
# beaconDB (keyless) is used next unless CELL_LOOKUP_DISABLE_PUBLIC=true. Only tower ids are sent.
OPENCELLID_API_KEY=
CELL_LOOKUP_DISABLE_PUBLIC=false
CELL_LOOKUP_BEACONDB_URL=https://api.beacondb.net/v1/geolocate
CELL_LOOKUP_TIMEOUT_MS=3000
CELL_LOOKUP_USER_AGENT=cab-screen-cms/1.0 (cell tower lookup)
# Longest time a request body may take to arrive (phone video uploads over mobile data), in
# seconds. Applied by apps/web/scripts/server-timeouts.cjs when the app runs with `npm run start`.
# Default 1800 (30 minutes). A proxy in front of the app needs a body/idle timeout at least as long.
REQUEST_TIMEOUT_SECONDS=1800

# Phone app (/m) sign-in. By default the phone app is OPEN: anyone with the address can see the
# cabs and change what plays without signing in; their actions are recorded in the activity log as
# "Phone app (not signed in)" with the request IP. Set to true to require sign-in for the phone app
# again (as before; takes effect on restart, no rebuild or code change). Team management, password
# changes, the desktop site and its API always require sign-in either way.
PHONE_APP_REQUIRE_SIGN_IN=false
# Most video uploads the open phone app accepts from callers who are not signed in, in any rolling
# hour, across all of them together (default 20; 0 = none). Signed-in users are not limited.
PHONE_APP_ANON_UPLOADS_PER_HOUR=20
