DATABASE_URL=postgresql://orison:password@localhost:5432/orison_cms
REDIS_URL=redis://localhost:6379
S3_BUCKET=orison-content
S3_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
CDN_BASE_URL=https://cdn.orisonscreens.com
NEXTAUTH_SECRET=replace-with-32-random-bytes
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_SESSION_COOKIE=orison_session
OPENWEATHERMAP_API_KEY=
NEWS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=jack@orisonscreens.com
DEFAULT_ADMIN_EMAIL=admin@orisonscreens.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEVICE_SHARED_TOKEN=replace-with-device-shared-secret
INLINE_MEDIA_JOBS=true

# Cell tower geolocation for heartbeats without GPS. OpenCelliD is used first when a key is set;
# beaconDB (keyless) is used next unless CELL_LOOKUP_DISABLE_PUBLIC=true. Only tower ids are sent.
OPENCELLID_API_KEY=
CELL_LOOKUP_DISABLE_PUBLIC=false
CELL_LOOKUP_BEACONDB_URL=https://api.beacondb.net/v1/geolocate
CELL_LOOKUP_TIMEOUT_MS=3000
CELL_LOOKUP_USER_AGENT=cab-screen-cms/1.0 (cell tower lookup)
# Longest time a request body may take to arrive (phone video uploads over mobile data), in
# seconds. Applied by apps/web/scripts/server-timeouts.cjs when the app runs with `npm run start`.
# Default 1800 (30 minutes). A proxy in front of the app needs a body/idle timeout at least as long.
REQUEST_TIMEOUT_SECONDS=1800
