# Every environment variable the app reads, with what it does. Copy to .env for local development;
# in production set them in Railway (service Variables). Blank = the default described.

# --- Database ------------------------------------------------------------------------------------
# PostgreSQL connection string (Prisma). Required.
DATABASE_URL=postgresql://orison:password@localhost:5432/orison_cms

# --- Object storage (S3-compatible) --------------------------------------------------------------
# Bucket for loops, assets, manifests and posters. With S3_BUCKET + both keys unset, files are kept on
# local disk under apps/web/tmp/storage (development only: a container's disk is lost on deploy).
S3_BUCKET=orison-content
# Bucket region.
S3_REGION=eu-west-2
# Access key id for the bucket.
AWS_ACCESS_KEY_ID=
# Secret for that key.
AWS_SECRET_ACCESS_KEY=
# Endpoint of a non-AWS S3 service (Railway buckets, R2, MinIO); blank = AWS.
AWS_ENDPOINT=
# "false" = virtual-hosted URLs (newer Railway buckets need this); default: path-style when AWS_ENDPOINT is set.
S3_FORCE_PATH_STYLE=
# Public base URL serving the bucket directly; blank = files are served through /api/storage/... (redirects to signed URLs).
CDN_BASE_URL=

# --- The web app ---------------------------------------------------------------------------------
# Signs the sign-in cookie: 32+ random bytes. Changing it signs everyone out.
SESSION_SECRET=replace-with-32-random-bytes
# Old name of SESSION_SECRET, read only when SESSION_SECRET is unset (kept so older deployments keep their sessions).
NEXTAUTH_SECRET=
# This app's public address, used to build file URLs (requests from another address are re-pointed to it).
APP_URL=http://localhost:3000
# Name of the sign-in cookie.
APP_SESSION_COOKIE=orison_session
# Port `next start` listens on (the Docker image sets 3000, which Railway expects).
PORT=3000
# Longest time, in seconds, a request body may take to arrive (apps/web/scripts/server-timeouts.cjs); default 1800, 0 = no limit.
REQUEST_TIMEOUT_SECONDS=1800
# Folder for upload pieces until a file is complete; default: <system temp>/orison-upload-sessions.
UPLOAD_SESSIONS_DIR=

# --- First admin ---------------------------------------------------------------------------------
# Created by the seed only if no user has this email; never changed afterwards.
DEFAULT_ADMIN_EMAIL=admin@orisonscreens.com
# That admin's first password (change it after signing in).
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- Cabs ----------------------------------------------------------------------------------------
# Shared bearer token every cab sends (Authorization: Bearer ...); must match the cabs' config.
DEVICE_SHARED_TOKEN=replace-with-device-shared-secret

# --- Phone app (/m) ------------------------------------------------------------------------------
# "true" = the phone app requires sign-in. Default (blank/false): open to anyone with the address.
PHONE_APP_REQUIRE_SIGN_IN=false
# Most video uploads per rolling hour from people not signed in, all together (default 20; 0 = none).
PHONE_APP_ANON_UPLOADS_PER_HOUR=20

# --- Retention (daily pruning in the web process) ------------------------------------------------
# Days of heartbeats kept (default 90; values under 30 become 30).
HEARTBEAT_RETENTION_DAYS=90
# Days of playback logs kept (what advertisers are billed from). Blank = kept forever; minimum 30.
PLAYBACK_LOG_RETENTION_DAYS=

# --- Cab positions from mobile masts (heartbeats without a GPS fix) ------------------------------
# OpenCelliD key; when set it is asked first.
OPENCELLID_API_KEY=
# "true" = never ask the keyless public service (beaconDB).
CELL_LOOKUP_DISABLE_PUBLIC=false
# beaconDB endpoint.
CELL_LOOKUP_BEACONDB_URL=https://api.beacondb.net/v1/geolocate
# Timeout of one lookup, in milliseconds.
CELL_LOOKUP_TIMEOUT_MS=3000
# User-Agent sent with lookups.
CELL_LOOKUP_USER_AGENT=cab-screen-cms/1.0 (cell tower lookup)

# --- Development tools only ----------------------------------------------------------------------
# Build/dev output folder instead of apps/web/.next (to run a dev server next to a build).
NEXT_DIST_DIR=
# apps/web/scripts/generate-mobile-icons.mjs: also write small previews of the icons here.
ORISON_ICON_PREVIEW_DIR=
